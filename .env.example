# SIMPLE configuration. Copy to .env and fill in.
#   cp .env.example .env
#
# Every setting is explained in docs/SERVER_SETUP_GUIDE.md, Step 4.
# Keep .env out of version control, and run: chmod 600 .env


# ─── Required. The application will not run without these. ───────────────────

DJANGO_SETTINGS_MODULE=spondon.settings.production
DEBUG=False

# Generate a fresh one. Never reuse another installation's.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# With the supplied docker-compose.yml the host is the service name, "db",
# and the password must match POSTGRES_PASSWORD there.
DATABASE_URL=postgresql://simple:CHANGE_ME@db:5432/simple

# Comma separated. The CSRF trusted origins are derived from this.
ALLOWED_HOSTS=simple.example.org

# Your own address. Used in generated links and in the webhook health check.
SIMPLE_PUBLIC_URL=https://simple.example.org

# Encrypts patient-identifying fields in the fistula and MPDSR modules.
# NEW installation: generate one.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MIGRATING an existing database: reuse that system's existing key, or every
# encrypted record becomes permanently unreadable.
FERNET_KEY=

# Old keys kept readable during a rotation. Comma separated. Normally blank.
FERNET_KEY_FALLBACKS=


# ─── Required for field data to arrive from KoboToolbox. ─────────────────────

KOBO_SERVER_URL=https://kf.kobotoolbox.org

# API token from your KoboToolbox account settings. Both names are read by
# different parts of the system, so set both to the same value.
KOBO_API_TOKEN=
KOBO_TOKEN=

# Shared secret. The webhook FAILS CLOSED: if this is blank, every incoming
# submission is rejected with 403. Put the same value in each KoboToolbox REST
# Service, as the header   Authorization: Token <this value>
KOBO_WEBHOOK_SECRET=

# Form identifiers, taken from each form's KoboToolbox URL.
KOBO_ASSET_UID_MPDSR=
KOBO_ASSET_UID_FISTULA=
KOBO_ASSET_UID_ACTIVITY=
KOBO_ASSET_UID_BASELINE=
KOBO_ASSET_UID_CLIENT_REG=
KOBO_ASSET_UID_BANDHU_ML=
KOBO_ASSET_UID_FISTULA_QB=
KOBO_ASSET_UID_MPDSR_ACTION=


# ─── Optional. Leave blank to switch the feature off. ────────────────────────

# AI written narrative in the monthly reports.
GROQ_API_KEY=

# Submission gap alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS={"PHD": "", "Bondhu": "", "CIPRB": "", "UNFPA": ""}

# Outgoing email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=

# Shared cache. Without it Django caches in process memory, which is correct
# at one worker and is how the system has been run.
REDIS_URL=

# Reconciles records deleted in KoboToolbox. Set to "all" to enable.
KOBO_DELETION_SYNC=
KOBO_DELETION_SYNC_HOURS=6

# Background loops. Set to 1 to enable.
ENABLE_RECON_LOOP=
RECON_INTERVAL_MIN=60
# Ignore submissions older than this date when reconciling. Blank = all.
RECON_IGNORE_BEFORE=
ENABLE_CSV_RESYNC_LOOP=
CSV_RESYNC_INTERVAL_MIN=10


# ─── One-time switch. Set, restart once, then blank it again. ────────────────
#
# SEED_DB creates the standard account set, but ONLY for accounts whose
# password variable is also set here. An account with no password is skipped
# with a warning, so SEED_DB on its own creates nobody.
#
# For a new installation it is simpler to skip this entirely and use
# createsuperuser instead. See Step 7 of the setup guide.

SEED_DB=
DEV_PASSWORD=
CIPRB_SAYEED_PASSWORD=
TANJINA_PASSWORD=
CIPRB_BASELINE_PASSWORD=
HABIB_PASSWORD=
PHD_MANAGER_PASSWORD=
PHD_FOCAL_PASSWORD=
BANDHU_MANAGER_PASSWORD=
BANDHU_IQBAL_PASSWORD=
BANDHU_FOCAL_PASSWORD=
UNFPA_ANIMESH_PASSWORD=
UNFPA_ROKHSANA_PASSWORD=
